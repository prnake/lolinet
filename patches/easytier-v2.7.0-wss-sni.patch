+/// SNI override for a WSS connection: the URL's `sni` query parameter, then the `ET_WSS_SNI`
+/// environment variable. Peer URLs learned from other nodes carry no query, so hole punching and
+/// relay connections rely on the environment default.
+fn wss_sni_override(url: &url::Url) -> Option<String> {
+    url.query_pairs()
+        .find(|(k, _)| k == "sni")
+        .map(|(_, v)| v.into_owned())
+        .or_else(|| std::env::var("ET_WSS_SNI").ok())
+        .filter(|s| !s.is_empty())
+}
+
+/// URL used for the WebSocket request: drops the `sni` parameter and, with an override, sends the
+/// same name in the Host header so the HTTP and TLS layers agree.
+fn ws_request_url(url: &url::Url, sni_override: Option<&str>) -> url::Url {
+    let mut out = url.clone();
+    let rest: Vec<(String, String)> = url
+        .query_pairs()
+        .filter(|(k, _)| k != "sni")
+        .map(|(k, v)| (k.into_owned(), v.into_owned()))
+        .collect();
+    if rest.is_empty() {
+        out.set_query(None);
+    } else {
+        out.query_pairs_mut().clear().extend_pairs(rest);
+    }
+    if let Some(name) = sni_override {
+        let _ = out.set_host(Some(name));
+    }
+    out
+}
