+/// lolinet: IPv4 / IPv6 包的传输层是不是 UDP（IPv6 只看第一个 next header，带扩展头的按非 UDP 处理）。
+fn inner_ip_is_udp(ip: &[u8]) -> bool {
+    match ip.first().map(|b| b >> 4) {
+        Some(4) => ip.get(9) == Some(&17),
+        Some(6) => ip.get(6) == Some(&17),
+        _ => false,
+    }
+}
+
+/// lolinet: KCP / QUIC 代理的传输包（不是代理后的数据包）。
+fn is_reliable_proxy_packet(packet_type: u8) -> bool {
+    [PacketType::KcpSrc, PacketType::KcpDst, PacketType::QuicSrc, PacketType::QuicDst]
+        .iter()
+        .any(|t| *t as u8 == packet_type)
+}
+
+/// lolinet: 本机发出的包（加密前）该偏好哪种隧道。
+fn local_tunnel_pref(msg: &ZCPacket) -> Option<crate::peers::conn::peer::TunnelPref> {
+    use crate::peers::conn::peer::TunnelPref;
+    let packet_type = msg.peer_manager_header().map(|h| h.packet_type);
+    match packet_type {
+        Some(t) if is_reliable_proxy_packet(t) => Some(TunnelPref::Stream),
+        Some(t)
+            if t != PacketType::Data as u8
+                && t != PacketType::DataWithKcpSrcModified as u8
+                && t != PacketType::DataWithQuicSrcModified as u8 =>
+        {
+            None
+        }
+        _ => inner_ip_is_udp(msg.payload()).then_some(TunnelPref::Udp),
+    }
+}
